{
  "name": "bitquest",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:server": "bun --watch server/src/server.ts",
    "server": "bun run server/src/server.ts",
    "dev:client": "bun run --cwd client dev",
    "build:client": "bun run --cwd client build",
    "check:map": "bun run tools/check_map.ts",
    "check:quests": "bun run tools/check_quests.ts",
    "check:dialogue": "bun run tools/check_dialogue.ts",
    "test:balance": "bun run tools/test_balance.ts",
    "test:perf": "bun run tools/test_perf.ts",
    "test:playthrough": "bun run tools/test_playthrough.ts",
    "test:coop": "bun run tools/test_coop.ts",
    "test:vfx": "bun run tools/test_vfx.ts",
    "test:foliage": "bun run tools/test_foliage.ts",
    "test:ambient_ai": "bun run tools/test_ambient_ai.ts",
    "test:blocks": "bun run tools/test_blocks.ts",
    "test:decals": "bun run tools/test_decals.ts",
    "test:elevation": "bun run tools/test_elevation.ts",
    "test:pathfinding": "bun run tools/test_pathfinding.ts",
    "test:spatial_culling": "bun run tools/test_spatial_culling.ts",
    "test:behaviors": "bun run tools/test_entity_behaviors.ts",
    "test:netcode": "bun run tools/test_netcode.ts",
    "test:magic": "bun run tools/test_magic_system.ts",
    "test:equipment": "bun run tools/test_equipment_system.ts",
    "ingest:assets": "bun run tools/ingest_assets.ts",
    "test:all": "bun run check:map && bun run check:quests && bun run check:dialogue && bun run test:balance && bun run test:perf && bun run test:playthrough && bun run test:coop && bun run test:vfx && bun run test:foliage && bun run test:ambient_ai && bun run test:blocks && bun run test:decals && bun run test:elevation && bun run test:pathfinding && bun run test:spatial_culling && bun run test:behaviors && bun run test:netcode && bun run test:magic && bun run test:equipment && bun run ingest:assets"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
